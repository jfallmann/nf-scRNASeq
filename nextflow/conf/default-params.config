params {
    // pipeline-specific parameters 
    sampleList = false
    optionalArgument = 'optional'

    // general pipeline parameters
    example = false
    help = false
    libraries = null

    // default parameters
    mapperBin = "CellRanger"
    starMappingParams = "--soloFeatures Gene GeneFull SJ Velocyto\
                         --soloMultiMappers EM \
                         --outSAMattributes NH HI nM AS CR UR CB UB GX GN sS sQ sM \
                         --outSAMtype BAM SortedByCoordinate \
                         --outSAMprimaryFlag AllBestScore "
    starMappingParamsScale = "--soloFeatures GeneFull_Ex50pAS \
                               --soloMultiMappers PropUnique \
                               --outSAMattributes NH HI nM AS CR UR CB UB GX GN sS sQ sM \
                               --outSAMtype BAM SortedByCoordinate \
                               --outSAMprimaryFlag AllBestScore \
                               --soloCBwhitelist None "
    scriptDirR = "${projectDir}/../docker/scripts/R/"
    scriptDirPy = "${projectDir}/../docker/scripts/python/"
    binDir = '/usr/local/bin/'
    qcParams = ''
    runQC = null
    crParams = ""
    idxParams = ""
    whitelist = null
    mapIndex = null
    mapRef = null
    mapAnno = null
    filter = null
    organism = "Human"
    chunkSize = 1_000_000
    maxDist = 2
    minReads = 10
    minDetectedFeatures = 500
    minDetectedBarcodes = 10
    bc1Cutoff = 0.4
    bc2Cutoff = 0.3
    singletCutoff = 0.8
    majorityVote = 90
    maxMtPercent = 10
    hvgCutoff = 0.1
    pvalCutoff = 0.1
    lfcCutoff = 1
    de_rds = null
    markerFile = "${projectDir}/../docker/data/R/stagemarkers_xue2020.rds"

    pipseq_config = null
    pipseq_cb_length = null
    pipseq_umi_length = null
    pipseq_offset = null
    pipseq_umi_offset = null
    pipseq_exact = null
    pipseq_clip3p = null
    pipseq_container = null
    r_container = null

    pipseqConfig = params.pipseq_config != null ? params.pipseq_config : "${projectDir}/conf/pipseq/pipspeak.yaml"
    pipseqCbLength = params.pipseq_cb_length != null ? params.pipseq_cb_length : 24
    pipseqUmiLength = params.pipseq_umi_length != null ? params.pipseq_umi_length : 12
    pipseqOffset = params.pipseq_offset != null ? params.pipseq_offset : 8
    pipseqUmiOffset = params.pipseq_umi_offset != null ? params.pipseq_umi_offset : 10
    pipseqExact = params.pipseq_exact != null ? params.pipseq_exact : false
    pipseqClip3p = params.pipseq_clip3p != null ? params.pipseq_clip3p : 45
    pipseqContainer = params.pipseq_container != null ? params.pipseq_container : 'ghcr.io/obenauflab/pipspeak:latest'

    // CLI-only aliases (fallback merged into the canonical params above in main.nf);
    // declared here as null so accessing them when unset doesn't warn
    fastqc_params = null
    mapper = null
    withQC = null
    cellranger_params = null
    star_params = null
    idx_params = null
    index = null
    reference = null
    annotation = null
    min_detected_barcodes = null
    markers = null
    singlet_cutoff = null
    bc1_cutoff = null
    bc2_cutoff = null
    max_mt_percent = null
    min_detected_features = null
    hvg_cutoff = null
    pval_cutoff = null
    lfc_cutoff = null
    baseline = null
    reportsDir = "${launchDir}/REPORTS"
    outputDir = "${launchDir}/nf-scRNASeq_nf_OUTPUT"
    stopOnWarnings = true

}
