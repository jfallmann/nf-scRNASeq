process {

    withName: "Cellranger_idx|runCellrangerCount" {
        container = 'nfcore/cellranger:7.1.0'
    }

    withName: "check_samplesheet|qc_raw|mqc|star_idx|star_mapping|generateReports|preprocessSingleCellData|createOverviewPlots|calculateBarcodeEnrichment|identifyDEGenes" {
        container = 'jfallmann/nfscrnaseq:main'
    }
}