process {

    withName: "Cellranger_idx|runCellrangerCount" {
        container = 'nfcore/cellranger:7.1.0'
    }

    withName: "check_samplesheet|qc_raw|mqc|concat_lanes|useCellrangerData|create_dummy_whitelist" {
        container = 'jfallmann/nfscrnaseq:main'
    }

    withName: "star_idx|star_mapping" {
        container = 'ghcr.io/obenauflab/catchseq:latest'
    }

    withName: "preprocessSingleCellData|createOverviewPlots|identifyDEGenes" {
        container = { params.containsKey('rContainer') ? params.rContainer : 'ghcr.io/obenauflab/catchseq:latest' }
    }

    withName: "preprocessPipseq" {
        container = { params.containsKey('pipseqContainer') ? params.pipseqContainer : 'ghcr.io/obenauflab/pipspeak:latest' }
    }
}
